# .env du Store WebPanel 2 (version PHP 8.2 / Laravel 12)
# Remplace base-name, user-name, xxxxxxx et localhost par tes vraies valeurs.
# Ne partage jamais ce fichier une fois rempli (il contient tes mots de passe).
APP_NAME=Store
APP_ENV=production
APP_DEBUG=false
# Clé de chiffrement : à générer AVANT la première ouverture du site, avec "php artisan key:generate --force"
# (chaque site doit avoir sa propre clé, ne jamais réutiliser celle d'un autre)
APP_KEY=
# adresse exacte du site (sert aussi à construire le lien du mail "mot de passe oublié")
APP_URL=http://localhost
# langue par défaut du site (fr ou en) ; chaque visiteur peut changer avec le bouton FR / EN
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Base du PANNEAU (comptes admin, rôles, serveurs) : tables webpanel_*
DB_CONNECTION=webpanel
DB_HOST_PANEL="localhost"
DB_PORT_PANEL=3306
DB_DATABASE_PANEL=base-name
DB_USERNAME_PANEL="user-name"
DB_PASSWORD_PANEL="xxxxxxx"
DB_PREFIX_PANEL=webpanel_

# Base du STORE (celle du plugin Store 1.2, jamais modifiée en structure) : tables store_*
DB_HOST_STORE="localhost"
DB_PORT_STORE=3306
DB_DATABASE_STORE=base-name
DB_USERNAME_STORE="user-name"
DB_PASSWORD_STORE="xxxxxxx"
DB_PREFIX_STORE=store_

SESSION_DRIVER=file
SESSION_LIFETIME=120
# mettre true si le site est en https (conseillé) ; laisser false en http, sinon la connexion ne tient pas
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Mails (lien "mot de passe oublié" des comptes admin) : SMTP de ton hébergeur
# port 465 = SSL (choisi automatiquement), port 587 = STARTTLS
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=465
MAIL_USERNAME=contact@localhost
# mot de passe du compte de messagerie, entre les guillemets (si il contient " ou \ , mettre un \ devant)
MAIL_PASSWORD="xxxxxxx"
MAIL_FROM_ADDRESS=contact@localhost
MAIL_FROM_NAME="Store"

# part du prix rendue à la revente (0.8 = 80 %)
UP_SERVERLOGIN_IGNORE_IPMISMATCH=false
UP_ITEMS_REFUNDFEE=0.8

# page "Joueurs" de l'espace joueur : classement et profils des autres joueurs
# (SteamID, objets possédés et équipés), en lecture seule, pour les joueurs connectés
USERPANEL_PLAYER_PROFILES=true
# crédits et rang des autres joueurs visibles sur cette page (false = cachés)
USERPANEL_PLAYER_PROFILES_CREDITS=true
